# Every variable src/ actually reads from the environment (grepped, not
# guessed — see the Milestone 9 hints). Copy to .env for local overrides;
# script/setup and script/start already default DB_PATH if unset.

# Path to the SQLite database file (src/db.py). Defaults to data/dev.sqlite.
DB_PATH=data/dev.sqlite

# --- Model integration (Milestone 12, CR-011; src/classify_propose/chain.py and ollama_client.py) ---
# KILL SWITCH. 1 = use the local Ollama model as the primary tier, 0 or unset = off (the rules tier only).
# Read on every report, so changing it needs no restart.
OLLAMA_ENABLED=0
# Where Ollama listens. Must be this machine over plain http (127.0.0.1, localhost or ::1); anything else is refused.
OLLAMA_URL=http://127.0.0.1:11434
# The model to ask. Default qwen3:1.7b.
OLLAMA_MODEL=qwen3:1.7b
# Optional second, smaller model used if the first fails (leave empty for none), e.g. smollm2:360m
OLLAMA_SMALLER_MODEL=
# Seconds to wait for one answer before giving up and falling back (default 60; FR-AGENT-04).
OLLAMA_TIMEOUT=60

# --- Background jobs (src/web_ui/app.py). script/start sets both; tests and imports leave them unset. ---
# Seconds between checks that free reservations whose 4-minute window ran out (default 1 in script/start).
SWEEP_SECONDS=1
# Seconds between purges of incident data older than 24 hours (NFR-PRIV-01; default 3600 in script/start).
PURGE_CHECK_SECONDS=3600
# Seconds between node-silence checks (FR-DEGRADE-01). Unset = off, because nothing in the demo sends heartbeats.
HEARTBEAT_CHECK_SECONDS=

# --- Sign-in (src/web_ui/auth_gate.py, src/auth/) ---
# 1 = every route except /healthz and /login needs a two-factor sign-in (script/start sets 1). 0 or unset = no gate.
AUTH_ENFORCED=1
# Optional: key that signs the session cookie. Leave unset to get a new random one at every start (sessions then end on restart).
SESSION_SIGNER=
