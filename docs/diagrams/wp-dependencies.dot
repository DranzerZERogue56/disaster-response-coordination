// Work-package dependency graph (finish-to-start) - Milestone 7 Medium Tier
// Version: v0.2   Date: 2026-10-10 - recomputed after the Sec 7 scope decision
// (6 tasks deferred: T-2.1b, T-3.3, T-10.2, T-12.4, T-11.2, T-11.3)
// Red = the critical path (longest E-weighted chain, work-package level): 82.92h
digraph wp_deps {
    rankdir=LR;
    fontname="Helvetica";
    node [fontname="Helvetica", shape=box, style=filled, fillcolor="#eef2f7"];
    edge [fontname="Helvetica", fontsize=10];

    "WP-1" [label="WP-1\nData Layer\n12.3h", fillcolor="#ffd6d6"];
    "WP-2" [label="WP-2\nLLM Client\n12.2h", fillcolor="#ffd6d6"];
    "WP-3" [label="WP-3\nIntake & Scenario Reader\n14.7h", fillcolor="#ffd6d6"];
    "WP-4" [label="WP-4\nResource Agents\n8.2h", fillcolor="#ffd6d6"];
    "WP-5" [label="WP-5\nNegotiation & Registry\n13.3h", fillcolor="#ffd6d6"];
    "WP-6" [label="WP-6\nApproval, Audit & Override\n9.3h"];
    "WP-7" [label="WP-7\nDispatcher Web UI\n12.3h"];
    "WP-8" [label="WP-8\nNotifications\n2.0h"];
    "WP-9" [label="WP-9\nRoster Competition\n11.0h", fillcolor="#ffd6d6"];
    "WP-10" [label="WP-10\nReport & Visualization\n3.2h\n(T-10.2 deferred)", fillcolor="#ffd6d6"];
    "WP-11" [label="WP-11\nTesting\n5.2h\n(T-11.2/T-11.3 deferred)"];
    "WP-12" [label="WP-12\nDocs, CI & Demo Prep\n8.0h\n(T-12.4 deferred)", fillcolor="#ffd6d6"];

    "WP-1" -> "WP-2" [color="#cc0000", penwidth=2];
    "WP-1" -> "WP-3";
    "WP-2" -> "WP-3" [color="#cc0000", penwidth=2];
    "WP-2" -> "WP-4";
    "WP-3" -> "WP-4" [color="#cc0000", penwidth=2];
    "WP-1" -> "WP-5";
    "WP-4" -> "WP-5" [color="#cc0000", penwidth=2];
    "WP-1" -> "WP-6";
    "WP-4" -> "WP-6";
    "WP-6" -> "WP-7";
    "WP-6" -> "WP-8";
    "WP-3" -> "WP-9";
    "WP-5" -> "WP-9" [color="#cc0000", penwidth=2];
    "WP-6" -> "WP-9";
    "WP-9" -> "WP-10" [color="#cc0000", penwidth=2];
    "WP-3" -> "WP-11";
    "WP-5" -> "WP-11";
    "WP-1" -> "WP-12"; "WP-2" -> "WP-12"; "WP-3" -> "WP-12"; "WP-4" -> "WP-12";
    "WP-5" -> "WP-12"; "WP-6" -> "WP-12"; "WP-7" -> "WP-12"; "WP-8" -> "WP-12";
    "WP-9" -> "WP-12"; "WP-10" -> "WP-12" [color="#cc0000", penwidth=2];
    "WP-11" -> "WP-12";

    note [shape=note, fillcolor="#f8f9fa", label="Red = critical path, 82.92h:\nWP-1 -> WP-2 -> WP-3 -> WP-4 -> WP-5\n-> WP-9 -> WP-10 -> WP-12\n\nShorter than the pre-deferral version (97.58h)\nmostly because WP-11's deferred tasks (T-11.2,\nT-11.3) no longer compete for the critical\nslot into WP-12 - WP-10 now carries that edge.\n\nFor a solo builder this is still NOT the whole\nstory: with no parallelism, total calendar time\nis bounded by the FULL active 111.8h sum, not\nthe 82.92h chain. WP-1/2/3 still sit at the root\nwith the most fan-out - protect those first."];
}
