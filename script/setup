#!/usr/bin/env bash
# One-command bootstrap for a fresh clone. Success looks like:
# "setup complete" printed last, with no errors above it, and
# data/dev.sqlite created with every migration applied.
set -euo pipefail
cd "$(dirname "$0")/.."

python3 -m venv .venv
if [ -f .venv/bin/python ]; then PY=.venv/bin/python; else PY=.venv/Scripts/python.exe; fi

# pip itself is pinned, and every package is installed only if its hash matches requirements-dev.txt (a superset of the
# runtime requirements.txt: it adds pytest, coverage, hypothesis and ruff). Both files are generated from the .in files.
"$PY" -m pip install "pip==26.2.2" -q
"$PY" -m pip install --require-hashes -r requirements-dev.txt -q

mkdir -p data
DB_PATH="${DB_PATH:-data/dev.sqlite}"
"$PY" tools/migrate.py "$DB_PATH"

echo "setup complete"
